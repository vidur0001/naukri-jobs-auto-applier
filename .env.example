SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-system-bot-email@gmail.com
SENDER_PASSWORD=your-gmail-app-password
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Protects the /solve-challenge live-browser viewer. Set this to a long
# random string; only links containing the matching ?token=... will load.
CHALLENGE_ACCESS_TOKEN=change-me-to-a-long-random-string

# Password required to view the noVNC live browser feed itself (defense in
# depth in case port 6080 is ever reachable without the token, e.g. if the
# security group is opened to 0.0.0.0/0 for phone access).
VNC_PASSWORD=change-me-too
